! --- Core appearance ---
XTerm*background:  #0e0e0e
XTerm*foreground:  #e6e6e6
XTerm*cursorColor: #e6e6e6

! --- Font (Xft) ---
XTerm*faceName: Terminus
XTerm*faceSize: 12

! --- Rendering ---
XTerm*antialias: true
XTerm*hinting:   true
XTerm*rgba:      rgb

! --- Bell ---
XTerm*visualBell:   false
XTerm*bellIsUrgent: false

! --- Selection ---
XTerm*selectToClipboard: true

! --- TERM correctness ---
XTerm*termName: xterm-256color

! --- ANSI colors ---
XTerm*color0:  #000000
